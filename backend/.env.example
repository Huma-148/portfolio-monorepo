# ---------------------------------------------------------------------------
# Environment contract. Copy to `.env` for local development:  cp .env.example .env
# The app validates all of this at startup (src/config/env.ts) and refuses to
# boot with a clear error listing every problem.
#
# In production, `.env` is NOT loaded: inject these from your platform / secret
# manager (e.g. AWS Secrets Manager) as real environment variables.
#
#   REQUIRED everywhere ........ DATABASE_URL
#   REQUIRED in production ..... JWT_SECRET, CORS_ORIGIN (no fallback)
#   Safe defaults (optional) ... PORT, LOG_LEVEL, JWT_EXPIRES_IN, TRUST_PROXY,
#                                RATE_LIMIT_GRAPHQL_*
# ---------------------------------------------------------------------------

# development | test | production   (default: development)
NODE_ENV=development

# --- REQUIRED --------------------------------------------------------------
# PostgreSQL connection string (must start with postgresql://)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio?schema=public"

# --- REQUIRED IN PRODUCTION (development falls back to a dev-only value) ---
# Production needs a unique secret of at least 32 characters; placeholder values
# such as "change-me..." are rejected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# Frontend origin allowed by CORS. Must be an exact origin: no "*", no path,
# no trailing slash (e.g. https://app.example.com).
CORS_ORIGIN="http://localhost:3000"

# --- OPTIONAL (safe defaults shown) ----------------------------------------
PORT=4000

# error | warn | info | http | verbose | debug | silly
# (default: debug outside production, info in production)
LOG_LEVEL=debug

# Token lifetime. A unit is required: 15m, 1h, 7d (a bare number is rejected).
JWT_EXPIRES_IN=1h

# Reverse proxy hops in front of the app (0 = none, 1 = single AWS ALB/nginx).
# Required for correct per-client rate limiting behind a load balancer.
TRUST_PROXY=0

# /graphql rate limiting (per client IP)
RATE_LIMIT_GRAPHQL_WINDOW_MS=60000
RATE_LIMIT_GRAPHQL_MAX=60
